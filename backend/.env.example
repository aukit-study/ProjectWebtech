# Server Configuration
PORT=5000

# JWT Configuration
# JWT_SECRET: ใช้เพื่อเซ็นชื่อและตรวจสอบ JWT token
# สำหรับ production ให้สร้าง secret ที่แข็งแรงและสุ่ม เช่น:
#   openssl rand -base64 32
JWT_SECRET=your_super_secret_key_here_change_this_in_production

# JWT_EXPIRES_IN: เวลาหมดอายุของ token
# ตัวอย่าง: 1h, 7d, 30d
JWT_EXPIRES_IN=1d

# Database Configuration (หากใช้ฐานข้อมูลอื่นนอกจาก SQLite)
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=projectwebtech
